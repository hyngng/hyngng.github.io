{
  "name": "new-blogging",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run fonts",
    "dev": "astro dev",
    "fonts": "node scripts/build-fonts.mjs",
    "prebuild": "npm run fonts && node -e \"require('node:fs').rmSync('public/pagefind',{recursive:true,force:true})\"",
    "build": "astro build",
    "postbuild": "pagefind --site dist --output-path dist/pagefind",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.3.5",
    "js-yaml": "^4.3.2",
    "katex": "^0.19.0",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.2.0",
    "micromark-extension-directive": "^4.0.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "micromark-extension-math": "^3.1.0",
    "qrcode": "^1.5.4",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-deflist": "^1.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/js-yaml": "^4.0.9",
    "@types/qrcode": "^1.5.6",
    "pagefind": "^1.5.2",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.0",
    "vite-plugin-pagefind": "^1.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "katex": "^0.19.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
