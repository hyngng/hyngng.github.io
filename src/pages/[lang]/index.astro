---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, localePath } from '../../utils/posts';
import { getLocale, availableLocales, defaultLocale } from '../../locales';
import HomePageContent from '../../components/HomePageContent.astro';

export async function getStaticPaths() {
  const locales = availableLocales.map((l) => l.code).filter((code) => code !== defaultLocale);
  return locales.map((code) => ({
    params: { lang: localePath(code).slice(1) },
  }));
}

const currentLocale = Astro.currentLocale || defaultLocale;
const locale = getLocale(currentLocale);
const sortedPosts = await getPublishedPosts({ lang: currentLocale });
---

<BaseLayout lang={currentLocale}>
  <HomePageContent locale={locale} currentLocale={currentLocale} posts={sortedPosts} />
</BaseLayout>
