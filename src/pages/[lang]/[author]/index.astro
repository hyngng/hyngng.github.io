---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ALL_AUTHORS, AUTHOR_PREFIX, getAuthor } from '../../../settings/authors.settings';
import { getSiteMeta } from '../../../settings/site.settings';
import { getPublishedPosts, getAuthorPath } from '../../../utils/posts';
import { getLocale, availableLocales, defaultLocale } from '../../../locales';
import AuthorPageContent from '../../../components/AuthorPageContent.astro';

export async function getStaticPaths() {
  const locales = availableLocales.map(l => l.code).filter(lang => lang !== defaultLocale);
  return ALL_AUTHORS.flatMap((author) =>
    locales.map((lang) => ({
      params: { lang, author: author.id },
      props: { author: getAuthor(author.id, lang), lang },
    }))
  );
}

const { author, lang } = Astro.props;
const locale = getLocale(lang);
const origin = Astro.url.origin;

const sortedPosts = await getPublishedPosts({ lang, authorId: author.id });
const breadcrumbItems = [
  { name: getSiteMeta(lang).title, url: new URL('/', origin).toString() },
  { name: author.name, url: new URL(getAuthorPath(author.id, lang), origin).toString() },
];
---

<BaseLayout lang={lang} authorId={author.id} title={`${AUTHOR_PREFIX}${author.name}`} description={author.description} breadcrumbItems={breadcrumbItems}>
  <AuthorPageContent author={author} locale={locale} currentLocale={lang} posts={sortedPosts} />
</BaseLayout>
