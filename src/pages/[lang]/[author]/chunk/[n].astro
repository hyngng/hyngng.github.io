---
import { getChunkStaticPaths } from '../../../../utils/chunkEndpoint';
import { availableLocales, defaultLocale, getLocale } from '../../../../locales';
import { ALL_AUTHORS, type AuthorId } from '../../../../settings/authors.settings';
import ChunkPageLayout from '../../../../layouts/ChunkPageLayout.astro';
import ChunkPostListBody from '../../../../components/ChunkPostListBody.astro';

export async function getStaticPaths() {
  const paths = [];
  for (const { code } of availableLocales) {
    if (code === defaultLocale) continue;
    for (const author of ALL_AUTHORS) {
      const chunkPaths = await getChunkStaticPaths(code, `/${code}/${author.id}/chunk`, author.id as AuthorId);
      for (const p of chunkPaths) {
        paths.push({
          params: { lang: code, author: author.id, n: p.params.n },
          props: p.props,
        });
      }
    }
  }
  return paths;
}

const { lang, author } = Astro.params;
const { posts, currentChunk, totalChunks, chunkBaseUrl, totalPosts } = Astro.props;
const locale = getLocale(lang);
const nextChunk = currentChunk < totalChunks ? currentChunk + 1 : null;
const homePath = `/${lang}/${author}/`;
---

<ChunkPageLayout lang={lang} title={`${locale.posts.title} - ${currentChunk}`}>
  <ChunkPostListBody {posts} {currentChunk} {chunkBaseUrl} {totalPosts} {nextChunk} homePath={homePath} {locale} currentLocale={lang} />
</ChunkPageLayout>
