---
import { getCollection } from 'astro:content';
import { getPostSlug, getPostLang, getPostPath } from '../../utils/posts';
import { defaultLocale } from '../../locales';

// Preserves the Jekyll-era URL scheme `/posts/{slug}/` by redirecting to the
// current post URL. Google treats a 0s meta refresh as a permanent redirect.
export async function getStaticPaths() {
  const posts = await getCollection('posts');

  return posts
    .filter((post) => !post.data.draft && getPostLang(post.id) === defaultLocale)
    .map((post) => ({
      params: { slug: getPostSlug(post.id) },
      props: { target: getPostPath(post.id, post.data.authors[0]) },
    }));
}

const { target } = Astro.props;
const absoluteTarget = Astro.site ? new URL(target, Astro.site).toString() : target;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <link rel="canonical" href={absoluteTarget} />
  <script is:inline define:vars={{ absoluteTarget }}>location = absoluteTarget;</script>
  <meta http-equiv="refresh" content={`0;url=${absoluteTarget}`} />
  <meta name="robots" content="noindex" />
</head>
<body>
  <a href={absoluteTarget}>이동이 자동으로 되지 않으면 여기를 클릭하세요.</a>
</body>
</html>
