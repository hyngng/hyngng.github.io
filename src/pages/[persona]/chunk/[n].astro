---
import { getChunkRoutes } from '../../../utils/chunkEndpoint';
import { defaultLocale, getLocale } from '../../../locales';
import ChunkPageLayout from '../../../layouts/ChunkPageLayout.astro';
import ChunkPostListBody from '../../../components/ChunkPostListBody.astro';

export async function getStaticPaths() {
  return getChunkRoutes({ personas: true });
}

const { persona } = Astro.params;
const { posts, currentChunk, totalChunks, chunkBaseUrl, totalPosts } = Astro.props;
const currentLocale = Astro.currentLocale || defaultLocale;
const locale = getLocale(currentLocale);
const nextChunk = currentChunk < totalChunks ? currentChunk + 1 : null;
const homePath = `/${persona}/`;
---

<ChunkPageLayout lang={currentLocale} title={`${locale.posts.title} - ${currentChunk}`}>
  <ChunkPostListBody {posts} {currentChunk} {chunkBaseUrl} {totalPosts} {nextChunk} homePath={homePath} {locale} currentLocale={currentLocale} />
</ChunkPageLayout>
