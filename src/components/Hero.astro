---
interface Props {
  title: string;
  description: string;
  avatarSrc?: string;
  avatarAlt?: string;
}

const { title, description, avatarSrc, avatarAlt = '' } = Astro.props;
---

<section class:list={['content-shell', 'hero', avatarSrc && 'has-avatar']} aria-labelledby="hero-title">
  <div class="hero-heading">
    {avatarSrc && (
      <img class="hero-avatar" src={avatarSrc} alt={avatarAlt} loading="eager" decoding="async" />
    )}
    <h1 id="hero-title">{title}</h1>
  </div>
  <p>{description}</p>
</section>

<style>
  .hero {
    margin-top: var(--hero-margin-top);
    color: var(--color-heading);
  }

  .hero-heading {
    display: flex;
    align-items: center;
    gap: var(--space-avatar-title);
  }

  h1 {
    margin: 0;
    color: var(--color-heading);
    font-size: var(--font-size-hero-title);
    line-height: var(--line-height-hero-title);
    font-weight: var(--font-weight-hero-title);
    letter-spacing: 0;
    text-rendering: geometricPrecision;
  }

  p {
    margin: var(--space-hero-title-description) 0 0;
    color: var(--color-heading);
    font-size: var(--font-size-hero-description);
    line-height: var(--line-height-hero-description);
    font-weight: 400;
    letter-spacing: 0;
  }

  .hero-avatar {
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: 50%;
    object-fit: cover;
    flex: 0 0 auto;
  }

  .has-avatar {
    margin-top: var(--hero-avatar-margin-top);
  }

  .has-avatar p {
    margin-top: var(--space-avatar-description);
  }

  @media (max-width: 960px) {
    .hero {
      margin-top: var(--hero-margin-top-mobile);
    }

    h1 {
      font-size: var(--font-size-hero-title-mobile);
      line-height: var(--line-height-hero-title-mobile);
    }
  }
</style>
