---
// Adsense ad unit. Not yet wired into any layout.
import { SITE } from '../../../settings/site.settings';

const { client, adSlot } = SITE.analytics.adsense;
---

<script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${client}`} crossorigin="anonymous"></script>
<ins class="adsbygoogle"
     style="display:block"
     data-ad-client={client}
     data-ad-slot={adSlot}
     data-ad-format="auto"
     data-full-width-responsive="true">
</ins>
<script is:inline>
  (adsbygoogle = window.adsbygoogle || []).push({});
</script>
