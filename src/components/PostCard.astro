---
import Persona from "./Persona.astro";
import { getPersona } from "../settings/personas.settings";
import { useLocale, defaultLocale } from "../locales";
import { extractExcerpt } from "../utils/posts";
import { getRelativeTime } from "../utils/relativeTime";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
  href: string;
  index?: number;
}

const { post, href, index = 0 } = Astro.props;
const { title, date, personas: personaIds, image } = post.data;
const locale = useLocale(Astro);
const excerpt = extractExcerpt(post.data.description, post.body);
const relativeDate = getRelativeTime(date, locale);

const primaryPersona = getPersona(personaIds[0], Astro.currentLocale || defaultLocale);
const personaSuffix = personaIds.length > 1
  ? ` ${locale.personas.otherPersonaSuffix(personaIds.length - 1)}`
  : undefined;
---

<article
  class:list={["post-card", { "post-card--with-image": !!image }]}
  data-path={href}
  data-index={index}
  style={`--post-order: ${index}`}
>
  <a href={href} class="post-card-link">
    {
      image && (
        <div
          class="post-card-image"
          style={image.lqip ? `--lqip-url:url("${image.lqip}")` : undefined}
        >
          <img
            src={image.path}
            alt={image.alt}
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }
    <div class="post-card-content">
      <h3 class="post-card-title">{title}</h3>
      <div class="post-card-meta">
        <div class="post-card-persona">
          <Persona
            avatar={primaryPersona.avatar}
            name={primaryPersona.name}
            nameSuffix={personaSuffix}
            info={relativeDate}
            clickable={false}
            truncate
          />
        </div>
        {excerpt && <p class="post-card-excerpt">{excerpt}</p>}
      </div>
    </div>
  </a>
</article>

<style>
  .post-card {
    background-color: var(--color-post-card-bg);
    border-radius: var(--post-card-radius);
    overflow: hidden;
    min-height: var(--post-card-height-no-image);
    display: flex;
    flex-direction: column;
  }

  .post-card-link {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    flex: 1;
    text-decoration: none;
    color: inherit;
  }

  .post-card-content {
    padding: var(--space-card-content-padding);
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .post-card-title {
    color: var(--color-heading);
    font-size: var(--post-card-font-title);
    font-weight: 700;
    line-height: var(--post-card-line-title);
    margin: 0 0 var(--space-card-title-gap) 0;
  }

  .post-card-meta {
    position: relative;
    overflow: hidden;
    min-height: var(--avatar-size);
  }

  .post-card-persona {
    width: fit-content;
    max-width: 100%;
  }

  .post-card-excerpt {
    position: absolute;
    inset: 0;
    margin: 0;
    transform: translateY(100%);

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;

    color: var(--color-text);
    font-size: var(--persona-info-size);
    line-height: calc(var(--avatar-size) / 2);
  }

  @media (hover: hover) and (pointer: fine) {
    .post-card-persona,
    .post-card-excerpt {
      transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1);
    }

    .post-card:hover .post-card-persona,
    .post-card:focus-within .post-card-persona {
      transform: translateY(-100%);
    }

    .post-card:hover .post-card-excerpt,
    .post-card:focus-within .post-card-excerpt {
      transform: translateY(0);
    }
  }

  /* ── Image ── */
  /* Geometry and LQIP (::before) rules are shared with LoadMoreCard —
     see the .post-card-image block in global.css. The img paints over the
     LQIP as soon as it is decoded; no reveal animation (it re-ran on every
     reload and read as flicker). */

  @media (prefers-reduced-motion: reduce) {
    .post-card-persona,
    .post-card-excerpt {
      transition: none;
    }
  }
</style>
