---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../locales';
import PostColumns from './PostColumns.astro';
import { getPostPath } from '../utils/posts';
import { SITE } from '../settings/site.settings';
import { distributePostColumns } from '../features/post-list/distribution';

interface Props {
  locale: Locale;
  posts: CollectionEntry<'posts'>[];
  currentLocale: string;
  chunkBaseUrl: string;
}

const { locale, posts, currentLocale, chunkBaseUrl } = Astro.props;
const chunkSize = SITE.postsPerPage;
const totalChunks = Math.ceil(posts.length / chunkSize);
const firstChunk = posts.slice(0, chunkSize);
const hasMore = totalChunks > 1;
const nextPreviewPost = hasMore ? posts[chunkSize] : undefined;
const totalRemaining = hasMore ? posts.length - chunkSize : 0;
const nextChunkCount = hasMore ? Math.min(chunkSize, totalRemaining) : 0;

const { left: leftPosts, right: rightPosts, loadMoreInLeft } = distributePostColumns(firstChunk, 0);
---

<section class="posts-section">
  <h2 class="section-title">{locale.posts.title}</h2>
  {posts.length === 0 ? (
    <p class="post-preview-state">{locale.posts.empty}</p>
  ) : (
    <div
      class="posts-grid"
      data-total-posts={posts.length}
      data-chunk-size={chunkSize}
      data-total-chunks={totalChunks}
      data-current-chunk="1"
      data-chunk-base-url={chunkBaseUrl}
      data-locale={currentLocale}
      data-all-posts={JSON.stringify(posts.map(post => ({
        path: getPostPath(post.id, post.data.authors, currentLocale),
        title: post.data.title,
        description: post.data.description || ''
      })))}
    >
      <PostColumns
        {leftPosts}
        {rightPosts}
        {loadMoreInLeft}
        showLoadMore={hasMore && !!nextPreviewPost}
        nextChunkUrl={`${chunkBaseUrl}/2`}
        {nextPreviewPost}
        {nextChunkCount}
        totalPosts={posts.length}
        {totalRemaining}
        loadMoreOrder={firstChunk.length}
        {locale}
        {currentLocale}
      />
    </div>
  )}
  <p class="search-empty post-preview-state" role="status" aria-live="polite" hidden>
    {locale.search.empty}
  </p>
</section>

<script>
  import { createPostListController, setController, needsRelayout, createChunkLoader, initMobileAuthorLink, MOBILE_QUERY } from '../features/post-list';

  let abortController: AbortController | undefined;

  function init() {
    abortController?.abort();
    abortController = new AbortController();
    const { signal } = abortController;

    const grid = document.querySelector('.posts-grid') as HTMLElement | null;
    if (!grid) return;

    initMobileAuthorLink(signal);

    const controller = createPostListController(grid);
    setController(controller);

    const columns = grid.querySelector('.posts-columns');
    if (needsRelayout(columns as HTMLElement | null)) {
      controller.relayout();
    }

    const mq = window.matchMedia(MOBILE_QUERY);
    mq.addEventListener('change', () => controller.relayout(), { signal });

    createChunkLoader(grid, controller, signal);
  }

  init();
</script>

<style>
  .posts-section {
    margin-top: var(--posts-section-margin-top);
    width: 100%;
    min-width: 0;
  }

  .section-title {
    color: var(--color-heading);
    font-size: var(--section-title-size);
    font-weight: 700;
    line-height: var(--section-title-line-height);
    margin: 0 0 var(--space-section-title-content) 0;
  }

  @media (max-width: 960px) {
    .section-title {
      display: none;
    }

    .posts-section {
      margin-top: var(--space-search-posts-gap);
    }
  }

</style>

<style is:global>
  @keyframes card-fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .post-card.is-new {
    opacity: 0;
    animation: card-fade-in 0.3s ease forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card.is-new {
      opacity: 1;
      animation: none;
    }
  }
</style>
