---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../locales';
import { defaultLocale } from '../locales';
import { ALL_AUTHORS, getAuthor, type AuthorId } from '../settings/authors.settings';
import { getSiteMeta } from '../settings/site.settings';
import Authors from './Authors.astro';
import Hero from './Hero.astro';
import PostListSection from './PostListSection.astro';
import Search from './Search.astro';

interface Props {
  locale: Locale;
  currentLocale: string;
  posts: CollectionEntry<'posts'>[];
}

const { locale, currentLocale, posts } = Astro.props;
const siteMeta = getSiteMeta(currentLocale);
const postCountByAuthor: Partial<Record<AuthorId, number>> = {};

posts.forEach((post) => {
  const authorIds = post.data.authors as AuthorId[];
  for (const id of authorIds) {
    postCountByAuthor[id] = (postCountByAuthor[id] || 0) + 1;
  }
});

const mainAuthors = ALL_AUTHORS.map((author) => ({
  id: author.id,
  avatar: getAuthor(author.id, currentLocale).avatar,
  name: author.name,
  info: locale.authors.postCount(postCountByAuthor[author.id as AuthorId] || 0),
}));

const chunkBaseUrl = currentLocale === defaultLocale
  ? '/posts/chunk'
  : `/${currentLocale}/posts/chunk`;
---

<Hero title={siteMeta.title} description={siteMeta.description} />
<Authors authors={mainAuthors} />

<div class="content-body-layout">
  <div class="search-mobile-wrapper">
    <Search locale={locale} currentLocale={currentLocale} />
  </div>
  <PostListSection locale={locale} posts={posts} currentLocale={currentLocale} chunkBaseUrl={chunkBaseUrl} />
  <aside class="search-sidebar">
    <Search locale={locale} currentLocale={currentLocale} />
  </aside>
</div>

