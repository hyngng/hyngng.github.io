---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../locales';
import { ALL_AUTHORS, getAuthor } from '../settings/authors.settings';
import { getSiteMeta } from '../utils/pageContext';
import { localePath } from '../utils/posts';
import Hero from './Hero.astro';
import PersonaModal from './PersonaModal.astro';
import PostListSection from './PostListSection.astro';
import Search from './Search.astro';

interface Props {
  locale: Locale;
  currentLocale: string;
  posts: CollectionEntry<'posts'>[];
}

const { locale, currentLocale, posts } = Astro.props;
const siteMeta = getSiteMeta(currentLocale);

const personaAuthors = ALL_AUTHORS.map((author) => {
  const authorData = getAuthor(author.name, currentLocale);
  return {
    id: author.name,
    name: author.name,
    avatar: authorData.avatar,
    description: authorData.description,
  };
});

const chunkBaseUrl = `${localePath(currentLocale)}/posts/chunk`;
---

<Hero
  title={siteMeta.title}
  description={siteMeta.description}
  personaCountText={locale.authors.personaCount(ALL_AUTHORS.length)}
  personaAvatars={personaAuthors.map((a) => a.avatar)}
  personaTargetModalId="persona-modal"
/>

<PersonaModal
  modalId="persona-modal"
  title={locale.authors.persona}
  authors={personaAuthors}
  currentLocale={currentLocale}
  closeAria={locale.authors.closeAria}
/>

<div class="content-body-layout">
  <div class="search-mobile-wrapper">
    <Search locale={locale} currentLocale={currentLocale} />
  </div>
  <PostListSection locale={locale} posts={posts} currentLocale={currentLocale} chunkBaseUrl={chunkBaseUrl} />
  <aside class="search-sidebar">
    <Search locale={locale} currentLocale={currentLocale} />
  </aside>
</div>
