---
import { useLocale } from '../locales';
import Author from './Author.astro';

interface AuthorItem {
  avatar?: string;
  name: string;
  info: string;
}

interface Props {
  title?: string;
  authors: AuthorItem[];
}

const locale = useLocale(Astro);
const { title = locale.authors.title, authors } = Astro.props;
---

<section class="content-shell authors" aria-labelledby="authors-title">
  <h2 id="authors-title">{title}</h2>
  <div id="authors-list-container" class="authors-list">
    {authors.map((author) => <Author {...author} />)}
  </div>
</section>
