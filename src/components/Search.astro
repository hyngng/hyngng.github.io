---
import type { Locale } from '../locales';
import { defaultLocale } from '../locales';

interface Props {
  locale: Locale;
  currentLocale: string;
}

const { locale, currentLocale } = Astro.props;
---

<aside class="search-container" aria-label={locale.search.aria}>
  <p class="search-title">{locale.search.title}</p>
  <form class="search-bar" role="search" action="javascript:void(0)">
    <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M416 208c0 45.9-14.9 88.3-40 122.7L502.6 457.4c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376c-34.4 25.2-76.8 40-122.7 40C93.1 416 0 322.9 0 208S93.1 0 208 0S416 93.1 416 208zM208 352a144 144 0 1 0 0-288 144 144 0 1 0 0 288z"/></svg>
    <input
      type="search"
      class="search-input"
      placeholder={locale.search.placeholder}
      aria-label={locale.search.aria}
      data-locale={currentLocale}
      data-default-locale={defaultLocale}
      autocomplete="off"
    />
  </form>
</aside>

<script>
  import { requireController, normalizePath, allPostsFromGrid } from '../features/post-list';

  type PagefindModule = {
    search: (q: string, opts?: { filters?: Record<string, string> }) => Promise<{ results: Array<{ data: () => Promise<{ url: string }> }> }>;
    init: () => Promise<void>;
  };

  let abortController: AbortController | undefined;

  let pagefind: PagefindModule | null = null;
  let pagefindLoadPromise: Promise<boolean> | null = null;

  const PAGEFIND_LOAD_TIMEOUT_MS = 3000;

  async function ensurePagefind(): Promise<boolean> {
    if (pagefind) return true;
    if (pagefindLoadPromise) return pagefindLoadPromise;

    const pagefindUrl = '/pagefind/pagefind.js';
    pagefindLoadPromise = (async () => {
      try {
        const timeout = new Promise<never>((_, reject) =>
          setTimeout(() => reject(new Error('pagefind load timeout')), PAGEFIND_LOAD_TIMEOUT_MS),
        );
        const mod = await Promise.race([import(/* @vite-ignore */ pagefindUrl), timeout]);
        await mod.init();
        pagefind = mod;
        return true;
      } catch {
        // Allow a retry on a later search instead of caching the failure forever.
        pagefindLoadPromise = null;
        return false;
      }
    })();

    return pagefindLoadPromise;
  }

  let debounceTimer: ReturnType<typeof setTimeout>;

  function initSearch() {
    abortController?.abort();
    abortController = new AbortController();
    const { signal } = abortController;

    if (!document.querySelector('.search-container')) return;

    const allInputs = document.querySelectorAll<HTMLInputElement>('.search-input');

    async function ensureMatchingChunksLoaded(
      controller: ReturnType<typeof requireController>,
      matchedPaths?: Set<string>,
      query?: string,
    ) {
      const grid = document.querySelector('.posts-grid') as HTMLElement | null;
      if (!grid?.dataset.allPosts) return;

      const allPosts = allPostsFromGrid(grid);
      const chunkSize = parseInt(grid.dataset.chunkSize || '6', 10);
      const currentChunk = parseInt(grid.dataset.currentChunk || '1', 10);

      const chunksToLoad = new Set<number>();

      allPosts.forEach((post, index) => {
        const postChunk = Math.floor(index / chunkSize) + 1;
        if (postChunk <= currentChunk) return;

        let isMatch = false;
        if (matchedPaths) {
          isMatch = matchedPaths.has(normalizePath(post.path));
        } else if (query) {
          const q = query.toLowerCase();
          isMatch = post.title.toLowerCase().includes(q) || ((post as any).description && (post as any).description.toLowerCase().includes(q));
        }

        if (isMatch) chunksToLoad.add(postChunk);
      });

      const sortedChunks = Array.from(chunksToLoad).sort((a, b) => a - b);
      for (const chunkNum of sortedChunks) {
        await controller.fetchSearchChunk(chunkNum);
      }
    }

    async function handleSearch(query: string) {
      allInputs.forEach(input => {
        if (input.value !== query) input.value = query;
      });

      const controller = requireController();

      if (!query) {
        controller.clearSearch();
        return;
      }

      if (pagefind) {
        await searchWithPagefind(query, controller);
      } else {
        const loaded = await ensurePagefind();
        if (loaded && pagefind) {
          await searchWithPagefind(query, controller);
        } else {
          await searchWithDOM(query, controller);
        }
      }
    }

    async function searchWithPagefind(query: string, controller: ReturnType<typeof requireController>) {
      const input = allInputs[0];
      const rawLocale = input?.dataset.locale || input?.dataset.defaultLocale || 'ko';
      const currentLocale = rawLocale.split('-')[0];
      const result = await pagefind!.search(query, {
        filters: { lang: currentLocale },
      });

      const matchedPaths = new Set<string>();
      for (const item of result.results) {
        const data = await item.data();
        if (data.url) {
          matchedPaths.add(normalizePath(data.url));
        }
      }

      await ensureMatchingChunksLoaded(controller, matchedPaths);
      controller.showSearchResults(Array.from(matchedPaths));
    }

    async function searchWithDOM(query: string, controller: ReturnType<typeof requireController>) {
      const grid = document.querySelector('.posts-grid') as HTMLElement | null;
      const allPosts = allPostsFromGrid(grid || document.createElement('div'));
      const q = query.toLowerCase();
      const matchedPaths = allPosts
        .filter(p => p.title.toLowerCase().includes(q) || (p.description && p.description.toLowerCase().includes(q)))
        .map(p => normalizePath(p.path));

      await ensureMatchingChunksLoaded(controller, undefined, query);
      controller.showSearchResults(matchedPaths);
    }

    function scheduleSearch(input: HTMLInputElement) {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        handleSearch(input.value.trim()).catch(err => {
          console.error('[search]', err);
        });
      }, 300);
    }

    allInputs.forEach(input => {
      input.addEventListener('input', () => scheduleSearch(input), { signal });
      input.addEventListener('compositionend', () => scheduleSearch(input), { signal });
    });

    document.querySelectorAll<HTMLFormElement>('.search-bar').forEach(form => {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const input = form.querySelector<HTMLInputElement>('.search-input');
        if (input) {
          clearTimeout(debounceTimer);
          handleSearch(input.value.trim()).catch(err => {
            console.error('[search]', err);
          });
        }
      }, { signal });
    });

    signal.addEventListener('abort', () => {
      clearTimeout(debounceTimer);
    });
  }

  initSearch();
</script>

<style>
  .search-container {
    width: 100%;
  }

  .search-title {
    margin: 0 0 var(--space-search-title-gap) 0;
    font-size: var(--post-card-font-title);
    font-weight: 700;
    color: var(--color-muted);
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: var(--space-search-bar-gap);
    width: var(--search-bar-width);
    height: var(--search-bar-height);
    padding: 0 var(--search-bar-padding-x);
    background-color: var(--color-post-card-bg);
    border-radius: 20px;
    box-sizing: border-box;
  }

  .search-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--color-muted);
  }

  .search-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-family-base);
    font-size: var(--font-size-base);
    color: var(--color-text);
    min-width: 0;
  }

  .search-input::placeholder {
    color: var(--color-muted);
    opacity: 0.7;
  }

  .search-bar:focus-within {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  @media (max-width: 1280px) {
    .search-title {
      display: none;
    }

    .search-bar {
      width: 100%;
    }
  }

</style>
