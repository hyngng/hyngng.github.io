---
import { getAuthorPath } from '../utils/posts';
import { AUTHOR_PREFIX } from '../settings/authors.settings';
import { defaultLocale } from '../locales';

interface Props {
  avatar?: string;
  name: string;
  nameSuffix?: string;
  info: string;
  id?: string;
  clickable?: boolean;
  truncate?: boolean;
}

const { avatar, name, nameSuffix, info, id, clickable = true, truncate = false } = Astro.props;
const currentLocale = Astro.currentLocale || defaultLocale;
const authorHref = id ? getAuthorPath(id, currentLocale) : undefined;
---

<article class={`author ${clickable && authorHref ? 'is-clickable' : ''}`}>
  {clickable && authorHref && <a href={authorHref} class="author-link"></a>}
  <div class="author-avatar" aria-hidden={avatar ? 'false' : 'true'}>
    {avatar && <img src={avatar} alt="" loading="lazy" decoding="async" onerror="this.remove()" />}
  </div>
  <div class="author-text">
    <span class:list={[truncate && 'author-name-truncate']}>{AUTHOR_PREFIX}{name}{nameSuffix && <span class="author-name-suffix">{nameSuffix}</span>}</span>
    {info && <p>{info}</p>}
  </div>
</article>

<style>
  .author {
    display: flex;
    align-items: center;
    gap: var(--space-author-avatar-text);
    min-width: 0;
    position: relative;
  }

  .author.is-clickable {
    cursor: pointer;
  }

  .author-avatar {
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: 50%;
    background-color: var(--author-avatar-placeholder);
    overflow: hidden;
    flex: 0 0 auto;
  }

  .author.is-clickable:hover .author-text span {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .author-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .author-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .author-text {
    min-width: 0;
  }

  span {
    display: block;
    margin: 0;
    color: var(--color-text);
    font-size: var(--author-name-size);
    line-height: var(--space-author-name-line-height);
    letter-spacing: 0;
    text-decoration: none;
  }

  .author-name-truncate {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .author-name-suffix {
    display: inline;
    color: var(--color-muted);
    font-size: var(--author-info-size);
    line-height: var(--space-author-info-line-height);
  }

  p {
    margin: var(--space-author-name-info) 0 0;
    color: var(--color-heading);
    font-size: var(--author-info-size);
    line-height: var(--space-author-info-line-height);
    font-weight: 400;
    letter-spacing: 0;
  }
</style>
