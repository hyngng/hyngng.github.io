---
import { SITE, defaultLocale, getLocaleEntry, getSiteMeta } from '../settings/site.settings';
import { buildWebSiteJsonLd, serializeJsonLd } from '../utils/jsonLd';
import { Font } from 'astro:assets';
import GoatCounter from './seo/analytics/GoatCounter.astro';
import GoogleAnalytics from './seo/analytics/GoogleAnalytics.astro';
import GoogleTagManager from './seo/analytics/GoogleTagManager.astro';
import WebmasterVerifications from './seo/webmasters_verifications/WebmasterVerifications.astro';
import ThemeInit from './ThemeInit.astro';

interface Props {
  title?: string;
  lang?: string;
}

const { title = SITE.title, lang = defaultLocale } = Astro.props;
const languageCode = getLocaleEntry(lang).code;
const siteMeta = getSiteMeta(lang);
const webSiteJsonLd = serializeJsonLd(
  buildWebSiteJsonLd({
    url: new URL('/', Astro.url.origin).toString(),
    name: siteMeta.title,
    description: siteMeta.description,
    image: new URL(SITE.ogImage, Astro.url.origin).toString(),
  }),
);
---

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>document.documentElement.dataset.js='true'</script>
    <meta name="language" content={languageCode} />
    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={webSiteJsonLd} />
    <ThemeInit />
    <WebmasterVerifications />
    <link rel="icon" type="image/svg+xml" href="/assets/img/favicons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicons/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicons/apple-touch-icon.png" />
    <link rel="alternate" type="text/markdown" title="LLM-friendly version" href="/llms.txt" />
    {import.meta.env.PROD && SITE.pwa.enabled && (
      <link rel="manifest" href="/manifest.webmanifest" />
    )}
    {import.meta.env.PROD && SITE.pwa.enabled && (
      <script>
        import { registerSW } from 'virtual:pwa-register';
        registerSW({ immediate: true });
      </script>
    )}
    <meta name="theme-color" content="#0a0a0a" />
    {
      SITE.resourceHints.map((hint) => (
        <link rel="preconnect" href={hint.origin} crossorigin={hint.crossorigin ? 'anonymous' : undefined} />
      ))
    }
    <Font cssVariable="--font-pretendard" preload={[{ weight: 400 }, { weight: 700 }]} />
    <style set:html={`:root{--configured-font-family:${SITE.fonts.baseStack};}`} />
    <GoogleAnalytics />
    <GoogleTagManager />
    <GoatCounter />
    <slot />
</head>
