---
import { getPersonaPath } from '../utils/posts';
import { PERSONA_PREFIX } from '../settings/personas.settings';
import { defaultLocale } from '../locales';
import Avatars from './Avatars.astro';

interface Props {
  avatar?: string;
  name: string;
  nameSuffix?: string;
  info: string;
  id?: string;
  clickable?: boolean;
  truncate?: boolean;
}

const { avatar, name, nameSuffix, info, id, clickable = true, truncate = false } = Astro.props;
const currentLocale = Astro.currentLocale || defaultLocale;
const personaHref = id ? getPersonaPath(id, currentLocale) : undefined;
---

<article class={`persona ${clickable && personaHref ? 'is-clickable' : ''}`}>
  {clickable && personaHref && <a href={personaHref} class="persona-link"></a>}
  <Avatars src={avatar} class="persona-avatar" />
  <div class="persona-text">
    <span class:list={[truncate && 'persona-name-truncate']}>{PERSONA_PREFIX}{name}{nameSuffix && <span class="persona-name-suffix">{nameSuffix}</span>}</span>
    {info && <p>{info}</p>}
  </div>
</article>

<style>
  .persona {
    display: flex;
    align-items: center;
    gap: var(--space-persona-avatar-text);
    min-width: 0;
    position: relative;
  }

  .persona.is-clickable {
    cursor: pointer;
  }

  .persona.is-clickable:hover .persona-text span {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .persona-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .persona-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .persona-text {
    min-width: 0;
  }

  span {
    display: block;
    margin: 0;
    color: var(--color-text);
    font-size: var(--persona-name-size);
    line-height: var(--space-persona-name-line-height);
    letter-spacing: 0;
    text-decoration: none;
  }

  .persona-name-truncate {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .persona-name-suffix {
    display: inline;
    color: var(--color-muted);
    font-size: var(--persona-info-size);
    line-height: var(--space-persona-info-line-height);
  }

  p {
    margin: var(--space-persona-name-info) 0 0;
    color: var(--color-heading);
    font-size: var(--persona-info-size);
    line-height: var(--space-persona-info-line-height);
    font-weight: 400;
    letter-spacing: 0;
  }
</style>
